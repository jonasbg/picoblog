<link rel="stylesheet" href="~/css/home.css" />
@model IEnumerable<MarkdownModel>

@{
  ViewData["Title"] = "Picoblog";
}

<div class="banner-grid browser">
@foreach (var doc in Model)
{
    <a class="hero" href="/post/@doc.Date?.Year/@doc.Title">
      <img src="/post/@doc.Date?.Year/@Uri.EscapeDataString(doc.Title)/@doc.CoverImage" loading="lazy">
      <div class="hero-text">
        <h4>@doc.Title</h4>
        <h5>@doc.Date?.ToString("dd. MMM yyyy")</h5>
      </div>
    </a>
}
</div>
