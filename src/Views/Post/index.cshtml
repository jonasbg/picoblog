<link rel="stylesheet" href="~/css/post.css" asp-append-version="true" />

@{
  ViewData["Title"] = Model.Title;
  ViewData["BodyClass"] =
      Model.HasPostPassword && User.Identity?.IsAuthenticated != true
          ? "post-body post-password-body"
          : "post-body";
  ViewData["Url"] = $"{Config.Domain}/post/{Model.Date?.Year}/{Uri.EscapeDataString(Model.Title)}";
  ViewData["Image"] = $"{Config.Domain}/post/{Model.Date?.Year}/{Uri.EscapeDataString(Model.Title)}/{Model.CoverImage}";
  var canViewPost =
      ViewData["CanViewPost"] as bool?
      ?? (User.Identity?.IsAuthenticated == true || (Config.Password == null && !Model.HasPostPassword));
  var postUrl = $"/post/{Model.Date?.Year}/{ContentSecurity.UrlEncodePathSegment(Model.Title)}";
  var loginUrl = Url.Action("Login", "Home", new { ReturnUrl = postUrl });
}

<div class="hero">
    @if(!string.IsNullOrEmpty(Model.CoverImage)) {
        <img class="full-screen-width" src="@(Uri.EscapeDataString(Model.Title)+"/"+Model.CoverImage)" alt="Banner Image">
    }
</div>

<button id="backButton" class="top-left">
    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-arrow-left-circle-fill" viewBox="0 0 16 16">
        <path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0zm3.5 7.5a.5.5 0 0 1 0 1H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5H11.5z"/>
    </svg>
</button>

<div class="content">
    <div class="center date">
        <h2>@Model.Title</h2>
        <p>@Model.Date?.ToString("MMM dd, yyyy")</p>
        @if (Model.Location != null)
        {
            <p class="post-location-text">@Model.Location.DisplayTitle</p>
        }
    </div>
    <button id="shareButton" class="circle">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-share-fill" viewBox="0 0 16 16">
            <path d="M11 2.5a2.5 2.5 0 1 1 .603 1.628l-6.718 3.12a2.499 2.499 0 0 1 0 1.504l6.718 3.12a2.5 2.5 0 1 1-.488.876l-6.718-3.12a2.5 2.5 0 1 1 0-3.256l6.718-3.12A2.5 2.5 0 0 1 11 2.5z"/>
        </svg>
    </button>

    <script>
        shareButton.addEventListener("click", onShare);
        async function onShare() {
            const title = document.title;
            const url = document.querySelector("link[rel=canonical]")
                ? document.querySelector("link[rel=canonical]").href
                : document.location.href;
            try {
                await navigator
                .share({
                    title,
                    url
                })
                } catch (err) { }
        }

        backButton.addEventListener("click", () => {
            window.location.href = document.referrer;
        });

    </script>

    @if (!canViewPost)
    {
    <div class="center">
        <h1>Locked post</h1>
        @if (Model.HasPostPassword)
        {
            <form method="post" action="@postUrl" class="login-form">
                @Html.AntiForgeryToken()
                <div class="form-group col-4" style="margin: 2rem auto;">
                    <input class="input-dark" name="password" type="password" autocomplete="current-password" />
                    @if (ViewData["PostPasswordError"] != null)
                    {
                        <span>@ViewData["PostPasswordError"]</span>
                    }
                </div>
                <button class="bnt-black" type="submit">Unlock</button>
            </form>
        }
        @if (Config.Password != null)
        {
            <button class="bnt-black" onclick="location.href='@loginUrl'" type="button">Login</button>
        }
    </div>
    return;
    }

    <div class="rendered-markdown">
        @{
        var html = ContentSecurity.SanitizeMarkdown(Model.Markdown, Model.Title);
        }
        @Html.Raw(html)
    </div>

    <div class="center">
        <a onclick="scrollToTop(event)">
            <img style="height: 3vw; margin-bottom: 10vh;" src="/icon/arrow_up.svg">
        </a>
    </div>
    <partial name="_ImageViewer" />
</div>

<script>
    function scrollToTop(event) {
        event.preventDefault();
        window.scrollTo(0, 0);
    }

document.addEventListener('DOMContentLoaded', function() {
    document.addEventListener('keydown', async function(event) {
            let textToCopy = '';

            switch(event.key) {
                case 't': // Title
                    textToCopy = document.querySelector('.date h2').innerText;
                    break;
                case 'd': // Date
                    let rawDate = document.querySelector('.date p').innerText.trim();
                    let date = new Date(rawDate);
                    if (!isNaN(date)) {
                        let formatter = new Intl.DateTimeFormat('de-DE', {
                            year: 'numeric',
                            month: '2-digit',
                            day: '2-digit'
                        });

                        let formattedDate = formatter.format(date);

                        let [day, month, year] = formattedDate.split('.');
                        textToCopy = `${year}/${month}/${day}`;
                    }
                    break;
                case 'b': // Body
                    textToCopy = document.querySelector('.rendered-markdown').innerText;
                    break;
            }

            if (textToCopy) {
                try {
                    await navigator.clipboard.writeText(textToCopy);
                } catch (err) {
                    console.error('Failed to copy text: ', err);
                }
            }

            event.preventDefault();
    })
});
</script>
