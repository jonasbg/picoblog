<link rel="stylesheet" href="~/css/home.css" />

<div class="banner-grid">
@foreach (var year in Model)
{
    var image = CalendarImage.ForYear(year, Cache.Models);
    <a class="hero" href="/calendar/@year">
      @if (image != null)
      {
        <img src="@image" loading="lazy">
      }
      <div class="hero-text">
        <h1>@year</h1>
      </div>
    </a>
}
</div>
